<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AEGIS PROCTOR AI // Cyberpunk Exam Security Platform</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">
    
    <!-- PDF.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- TensorFlow.js Core & COCO-SSD Models -->
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.17.0/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd@2.2.3/dist/coco-ssd.min.js"></script>

    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cyber: {
                            bg: '#020617',
                            card: 'rgba(10, 16, 32, 0.92)',
                            border: '#1e293b',
                            cyan: '#00f0ff',
                            magenta: '#ff0055',
                            purple: '#8b5cf6',
                            amber: '#f59e0b',
                            green: '#10b981',
                            red: '#ef4444'
                        }
                    },
                    fontFamily: {
                        orbitron: ['Orbitron', 'sans-serif'],
                        rajdhani: ['Rajdhani', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            background-color: #020617;
            color: #f8fafc;
            font-family: 'Rajdhani', sans-serif;
            overflow-x: hidden;
            user-select: none;
        }

        .glass-panel {
            background: rgba(10, 18, 36, 0.88);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 240, 255, 0.25);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
        }

        .glass-panel-danger {
            background: rgba(30, 5, 12, 0.95);
            backdrop-filter: blur(20px);
            border: 2px solid rgba(239, 68, 68, 0.9);
            box-shadow: 0 0 60px rgba(239, 68, 68, 0.7);
        }

        .cyber-border-glow-danger {
            box-shadow: 0 0 35px rgba(239, 68, 68, 0.85);
            animation: pulseDanger 0.8s infinite alternate;
        }

        @keyframes pulseDanger {
            0% { box-shadow: 0 0 20px rgba(239, 68, 68, 0.5); }
            100% { box-shadow: 0 0 55px rgba(239, 68, 68, 0.95); }
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #020617;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00f0ff;
        }

        @keyframes scanline {
            0% { transform: translateY(-100%); }
            100% { transform: translateY(1200%); }
        }

        .scanner-line {
            background: linear-gradient(180deg, rgba(239, 68, 68, 0) 0%, rgba(239, 68, 68, 0.9) 50%, rgba(239, 68, 68, 0) 100%);
        }

        @keyframes glitch {
            0% { transform: translate(0) }
            20% { transform: translate(-4px, 4px) }
            40% { transform: translate(-4px, -4px) }
            60% { transform: translate(4px, 4px) }
            80% { transform: translate(4px, -4px) }
            100% { transform: translate(0) }
        }

        .red-glitch {
            animation: glitch 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) both infinite;
        }

        .hud-grid {
            background-size: 30px 30px;
            background-image: 
                linear-gradient(to right, rgba(0, 240, 255, 0.05) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(0, 240, 255, 0.05) 1px, transparent 1px);
        }

        .progress-ring-circle {
            transition: stroke-dashoffset 0.35s;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between relative overflow-x-hidden font-rajdhani selection:bg-cyber-cyan selection:text-black">

    <canvas id="bgCanvas" class="fixed inset-0 pointer-events-none z-0"></canvas>
    <div class="fixed inset-0 hud-grid pointer-events-none z-0 opacity-60"></div>

    <!-- MAIN SYSTEM CONTAINER -->
    <div id="appContainer" class="relative z-10 flex flex-col min-h-screen">
        
        <!-- HEADER HUD TOOLBAR -->
        <header class="glass-panel border-b border-cyber-border px-4 md:px-6 py-3 flex items-center justify-between sticky top-0 z-30">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-cyan-950/80 border border-cyber-cyan/60 rounded-lg text-cyber-cyan shadow-[0_0_15px_rgba(0,240,255,0.4)]">
                    <i data-lucide="shield-check" class="w-6 h-6 animate-pulse"></i>
                </div>
                <div>
                    <h1 class="font-orbitron font-extrabold text-base md:text-xl tracking-wider text-white flex items-center gap-2">
                        AEGIS <span class="text-cyber-cyan text-xs md:text-sm px-2 py-0.5 rounded bg-cyber-cyan/10 border border-cyber-cyan/40">PROCTOR AI</span>
                    </h1>
                    <p class="text-[10px] md:text-xs text-slate-400 font-mono tracking-widest uppercase">Unbreakable Cyberpunk HUD Examination Safeguard</p>
                </div>
            </div>

            <!-- Active Exam HUD Metrics -->
            <div id="hudHeaderMetrics" class="hidden flex items-center space-x-3 md:space-x-6">
                <!-- Lock Status -->
                <div class="hidden lg:flex items-center space-x-2 bg-slate-900/90 px-3 py-1.5 rounded-lg border border-slate-700/80 font-mono text-xs">
                    <i data-lucide="lock" class="w-4 h-4 text-cyber-green"></i>
                    <span class="text-slate-400">LOCKDOWN:</span>
                    <span id="focusLockBadge" class="text-cyber-green font-bold">ACTIVE</span>
                </div>

                <!-- Progress Ring & Countdown Timer -->
                <div class="flex items-center space-x-3 bg-slate-900/95 px-3.5 py-1.5 rounded-lg border border-cyber-cyan/60 shadow-[0_0_15px_rgba(0,240,255,0.25)]">
                    <div class="relative w-8 h-8 flex items-center justify-center">
                        <svg class="w-8 h-8">
                            <circle class="text-slate-800" stroke-width="3" stroke="currentColor" fill="transparent" r="12" cx="16" cy="16" />
                            <circle id="timerProgressRing" class="text-cyber-cyan progress-ring-circle" stroke-width="3" stroke-dasharray="75.39" stroke-dashoffset="0" stroke-linecap="round" stroke="currentColor" fill="transparent" r="12" cx="16" cy="16" />
                        </svg>
                        <i data-lucide="clock" class="w-3.5 h-3.5 text-cyber-cyan absolute"></i>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[9px] text-slate-400 font-mono tracking-wider uppercase leading-none">Remaining</span>
                        <span id="examTimer" class="font-orbitron text-base md:text-lg font-bold tracking-widest text-cyber-cyan">00:00:00</span>
                    </div>
                </div>
            </div>

            <div class="flex items-center space-x-3">
                <button id="soundToggleBtn" class="p-2 rounded-lg bg-slate-800/90 hover:bg-slate-700/90 border border-slate-600 text-slate-300 transition-all flex items-center space-x-1.5 text-xs font-mono">
                    <i data-lucide="volume-2" id="soundIcon" class="w-4 h-4 text-cyber-cyan"></i>
                    <span id="soundStatusText" class="hidden sm:inline">AUDIO: ON</span>
                </button>
                <div class="hidden md:block text-right font-mono text-xs text-slate-400">
                    <div id="sysClock" class="text-slate-200 font-semibold">00:00:00 UTC</div>
                    <div id="sysEngineLabel" class="text-[10px] text-cyber-cyan">HYBRID VISION + SENSOR ENGINE</div>
                </div>
            </div>
        </header>

        <!-- VIEW 1: PRE-TEST SETUP STAGE -->
        <main id="setupStage" class="flex-1 p-4 md:p-8 max-w-7xl mx-auto w-full flex flex-col gap-6">
            
            <div class="glass-panel rounded-2xl p-6 border-cyber-cyan/30 relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-cyber-cyan/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 relative z-10">
                    <div>
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyber-cyan/10 border border-cyber-cyan/30 text-cyber-cyan text-xs font-mono mb-2">
                            <i data-lucide="cpu" class="w-3.5 h-3.5"></i>
                            CYBERPUNK NEON PROCTORING ENGINE INITIALIZED
                        </div>
                        <h2 class="text-2xl md:text-4xl font-orbitron font-extrabold text-white tracking-wide">
                            AEGIS LOCKDOWN EXAMINATION SYSTEM
                        </h2>
                        <p class="text-slate-400 text-sm md:text-base mt-1 max-w-2xl">
                            Review security mandates, load test document, select duration, and calibrate camera before entering lockdown.
                        </p>
                    </div>
                    
                    <div class="flex items-center gap-3 bg-red-950/40 p-3.5 rounded-xl border border-red-500/50 shrink-0">
                        <i data-lucide="shield-alert" class="w-8 h-8 text-cyber-red shrink-0"></i>
                        <div class="text-xs text-slate-300 font-mono">
                            <span class="text-cyber-red font-bold block uppercase">Strict Security Enforcements</span>
                            Switching tabs, leaving webcam view, or covering the camera causes immediate disqualification.
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- Rules & Setup (Left 7 Cols) -->
                <div class="lg:col-span-7 flex flex-col gap-6">
                    
                    <div class="glass-panel rounded-2xl p-6 flex flex-col gap-4">
                        <div class="flex items-center space-x-2 text-cyber-cyan border-b border-slate-800 pb-3">
                            <i data-lucide="file-warning" class="w-5 h-5"></i>
                            <h3 class="font-orbitron font-bold text-lg text-white">1. Examination Mandates & Regulations</h3>
                        </div>

                        <ul class="space-y-2.5 text-sm text-slate-300 font-rajdhani">
                            <li class="flex items-start space-x-3 bg-slate-900/70 p-3 rounded-xl border border-slate-800">
                                <i data-lucide="external-link" class="w-5 h-5 text-cyber-red shrink-0 mt-0.5"></i>
                                <div>
                                    <strong class="text-white">1. Screen & Tab Lock:</strong> Switching tabs, leaving fullscreen mode, or focusing on external windows instantly terminates the session.
                                </div>
                            </li>
                            <li class="flex items-start space-x-3 bg-slate-900/70 p-3 rounded-xl border border-slate-800">
                                <i data-lucide="user-x" class="w-5 h-5 text-cyber-red shrink-0 mt-0.5"></i>
                                <div>
                                    <strong class="text-white">2. Camera Absence Lock:</strong> Leaving webcam view for more than 2 seconds terminates the exam.
                                </div>
                            </li>
                            <li class="flex items-start space-x-3 bg-slate-900/70 p-3 rounded-xl border border-slate-800">
                                <i data-lucide="eye-off" class="w-5 h-5 text-cyber-red shrink-0 mt-0.5"></i>
                                <div>
                                    <strong class="text-white">3. Camera Lens Lock:</strong> Covering camera lens or obstructing frame brightness terminates the session.
                                </div>
                            </li>
                        </ul>

                        <div class="space-y-2 pt-2 border-t border-slate-800/80 font-mono text-xs">
                            <label class="flex items-center space-x-3 cursor-pointer text-slate-300 hover:text-white">
                                <input type="checkbox" id="chkRules" class="w-4 h-4 rounded border-slate-700 bg-slate-900 text-cyber-cyan focus:ring-cyber-cyan">
                                <span>I accept that leaving fullscreen or switching tabs results in instant disqualification.</span>
                            </label>
                            <label class="flex items-center space-x-3 cursor-pointer text-slate-300 hover:text-white">
                                <input type="checkbox" id="chkDevices" class="w-4 h-4 rounded border-slate-700 bg-slate-900 text-cyber-cyan focus:ring-cyber-cyan">
                                <span>I agree to maintain clear webcam presence and follow all proctoring protocols.</span>
                            </label>
                        </div>
                    </div>

                    <!-- PDF Upload & Duration Selector -->
                    <div class="glass-panel rounded-2xl p-6 flex flex-col gap-5">
                        <div class="flex items-center space-x-2 text-cyber-cyan border-b border-slate-800 pb-3">
                            <i data-lucide="file-up" class="w-5 h-5"></i>
                            <h3 class="font-orbitron font-bold text-lg text-white">2. Question Document & Duration Selector</h3>
                        </div>

                        <div id="pdfDropZone" class="border-2 border-dashed border-slate-700 hover:border-cyber-cyan/80 rounded-xl p-5 flex flex-col items-center justify-center cursor-pointer transition-all bg-slate-950/40 group">
                            <input type="file" id="pdfFileInput" accept="application/pdf" class="hidden">
                            <i data-lucide="file-text" class="w-10 h-10 text-slate-500 group-hover:text-cyber-cyan transition-colors mb-2"></i>
                            <span id="pdfFileName" class="text-sm font-semibold text-slate-300 group-hover:text-white">Click or drag test question PDF here</span>
                            <span class="text-xs text-slate-500 font-mono mt-1">Accepts PDF exam papers</span>
                            <button type="button" id="loadSamplePdfBtn" class="mt-3 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyber-cyan text-xs font-mono border border-cyber-cyan/30 transition-all flex items-center space-x-1.5">
                                <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                                <span>Load Built-in Quantum Mechanics Exam</span>
                            </button>
                        </div>

                        <div>
                            <label class="block text-xs font-mono text-slate-400 mb-2 uppercase tracking-wider">Select Duration:</label>
                            <div class="grid grid-cols-5 gap-2">
                                <button type="button" data-duration="5" class="duration-btn bg-slate-900 border-slate-700 hover:border-slate-500 text-slate-300 p-2 rounded-lg border font-orbitron text-center text-xs font-bold transition-all">5 Mins</button>
                                <button type="button" data-duration="15" class="duration-btn bg-slate-900 border-slate-700 hover:border-slate-500 text-slate-300 p-2 rounded-lg border font-orbitron text-center text-xs font-bold transition-all">15 Mins</button>
                                <button type="button" data-duration="30" class="duration-btn active bg-cyber-cyan/20 border-cyber-cyan text-white p-2 rounded-lg border font-orbitron text-center text-xs font-bold transition-all">30 Mins</button>
                                <button type="button" data-duration="60" class="duration-btn bg-slate-900 border-slate-700 hover:border-slate-500 text-slate-300 p-2 rounded-lg border font-orbitron text-center text-xs font-bold transition-all">60 Mins</button>
                                <button type="button" id="customDurationBtn" class="duration-btn bg-slate-900 border-slate-700 hover:border-slate-500 text-slate-300 p-2 rounded-lg border font-orbitron text-center text-xs font-bold transition-all">Custom</button>
                            </div>
                            <div id="customDurationInputBox" class="hidden mt-2 flex items-center gap-2">
                                <input type="number" id="customDurationMinutes" min="1" max="300" value="45" class="bg-slate-950 border border-slate-700 rounded-lg p-2 text-xs font-mono text-slate-200 focus:outline-none focus:border-cyber-cyan w-32">
                                <span class="text-xs font-mono text-slate-400">Minutes</span>
                            </div>
                        </div>

                    </div>

                </div>

                <!-- Camera Check & Calibration (Right 5 Cols) -->
                <div class="lg:col-span-5 flex flex-col gap-6">
                    <div class="glass-panel rounded-2xl p-6 flex flex-col gap-4">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                            <div class="flex items-center space-x-2 text-cyber-cyan">
                                <i data-lucide="camera" class="w-5 h-5"></i>
                                <h3 class="font-orbitron font-bold text-lg text-white">3. Camera & Sensor Calibration</h3>
                            </div>
                            <span id="camStatusBadge" class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">OFFLINE</span>
                        </div>

                        <!-- Video Preview Box -->
                        <div class="relative rounded-xl overflow-hidden bg-black aspect-video border border-slate-800 flex items-center justify-center">
                            <video id="previewWebcam" autoplay playsinline muted class="w-full h-full object-cover transform scale-x-[-1]"></video>

                            <div id="camPlaceholder" class="flex flex-col items-center justify-center p-6 text-center">
                                <i data-lucide="video-off" class="w-12 h-12 text-slate-600 mb-2"></i>
                                <p class="text-xs text-slate-400 font-mono max-w-xs mb-3">Initialize webcam to perform pre-test security calibration.</p>
                                <button type="button" id="startCamCheckBtn" class="px-4 py-2 bg-cyber-cyan/10 hover:bg-cyber-cyan/20 border border-cyber-cyan/50 text-cyber-cyan rounded-lg text-xs font-mono font-bold flex items-center space-x-2 transition-all">
                                    <i data-lucide="power" class="w-4 h-4"></i>
                                    <span>Initialize Camera & Frame Analyzer</span>
                                </button>
                            </div>
                        </div>

                        <!-- Real-time Diagnostic Readouts -->
                        <div class="space-y-2 text-xs font-mono bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">Vision Analysis Engine:</span>
                                <span id="tfEngineStatus" class="text-cyber-green font-bold flex items-center gap-1"><i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i> READY</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">Absence Lock Threshold:</span>
                                <span class="text-cyber-cyan font-bold">2.0 Seconds</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">Covered Lens Detector:</span>
                                <span class="text-cyber-green font-bold">ACTIVE (Brightness Sensor)</span>
                            </div>
                        </div>

                        <button id="startTestBtn" disabled class="w-full py-4 rounded-xl bg-slate-800 border border-slate-700 text-slate-500 font-orbitron font-extrabold text-sm md:text-base tracking-wider transition-all duration-300 cursor-not-allowed flex items-center justify-center space-x-2">
                            <i data-lucide="shield-alert" class="w-5 h-5"></i>
                            <span>START EXAM (ENTER LOCKDOWN)</span>
                        </button>
                    </div>
                </div>

            </div>
        </main>

        <!-- VIEW 2: ACTIVE EXAM WORKSPACE -->
        <main id="examStage" class="hidden flex-1 p-2 md:p-4 flex flex-col gap-3 h-[calc(100vh-65px)] overflow-hidden">
            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 flex-1 h-full min-h-0">
                
                <!-- Left Pane: PDF Exam Viewer (7 Columns) -->
                <section class="lg:col-span-7 glass-panel rounded-xl border-cyber-border flex flex-col overflow-hidden h-full">
                    <div class="bg-slate-900/95 border-b border-slate-800 p-2 px-3 flex items-center justify-between shrink-0 font-mono text-xs">
                        <div class="flex items-center space-x-2">
                            <span class="text-cyber-cyan font-bold flex items-center gap-1">
                                <i data-lucide="file-text" class="w-4 h-4"></i>
                                QUESTION PAPER
                            </span>
                            <span id="pdfTitleDisplay" class="text-slate-400 truncate max-w-[180px]">paper.pdf</span>
                        </div>

                        <div class="flex items-center space-x-2">
                            <button id="pdfPrevPage" class="p-1 hover:bg-slate-800 text-slate-300 rounded border border-slate-700">
                                <i data-lucide="chevron-left" class="w-4 h-4"></i>
                            </button>
                            <span class="text-slate-300 text-[11px]">
                                <span id="pdfCurrentPage" class="text-cyber-cyan font-bold">1</span> / <span id="pdfTotalPages">1</span>
                            </span>
                            <button id="pdfNextPage" class="p-1 hover:bg-slate-800 text-slate-300 rounded border border-slate-700">
                                <i data-lucide="chevron-right" class="w-4 h-4"></i>
                            </button>
                            <div class="h-4 w-px bg-slate-800"></div>
                            <button id="pdfZoomOut" class="p-1 hover:bg-slate-800 text-slate-300 rounded border border-slate-700">
                                <i data-lucide="zoom-out" class="w-4 h-4"></i>
                            </button>
                            <span id="zoomLevelText" class="text-[11px] text-slate-400 w-8 text-center">100%</span>
                            <button id="pdfZoomIn" class="p-1 hover:bg-slate-800 text-slate-300 rounded border border-slate-700">
                                <i data-lucide="zoom-in" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                    <div id="pdfViewerWrapper" class="flex-1 overflow-auto p-4 flex justify-center items-start bg-slate-950/90 relative">
                        <div id="pdfLoadingSpinner" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950/80 z-10">
                            <i data-lucide="loader-2" class="w-8 h-8 text-cyber-cyan animate-spin mb-2"></i>
                            <span class="text-xs font-mono text-slate-400">Rendering Question Paper Canvas...</span>
                        </div>
                        <canvas id="pdfCanvas" class="shadow-2xl border border-slate-800 rounded max-w-full"></canvas>
                    </div>
                </section>

                <!-- Right Pane: Camera, HUD Metrics & Answer Console (5 Columns) -->
                <section class="lg:col-span-5 flex flex-col gap-3 h-full overflow-hidden">
                    
                    <!-- Top Widget: Live AI Proctor Feed -->
                    <div id="proctorCameraBox" class="glass-panel rounded-xl p-3 border-cyber-border flex gap-3 items-center shrink-0 relative transition-all duration-300">
                        <div class="relative w-44 aspect-video bg-black rounded-lg overflow-hidden border border-cyber-cyan/40 shrink-0">
                            <video id="examWebcam" autoplay playsinline muted class="w-full h-full object-cover transform scale-x-[-1]"></video>
                            <canvas id="examBoundingCanvas" class="absolute inset-0 w-full h-full pointer-events-none transform scale-x-[-1]"></canvas>
                            
                            <div class="absolute top-1 left-1 flex items-center space-x-1 bg-black/80 px-1.5 py-0.5 rounded border border-cyber-cyan/30">
                                <span class="w-1.5 h-1.5 rounded-full bg-cyber-green animate-ping"></span>
                                <span class="text-[8px] font-mono text-cyber-green">SCANNING</span>
                            </div>
                        </div>

                        <!-- Live Sensor Readouts -->
                        <div class="flex-1 min-w-0 font-mono text-xs space-y-1">
                            <div class="flex justify-between items-center">
                                <span class="text-slate-400 text-[11px]">User Presence:</span>
