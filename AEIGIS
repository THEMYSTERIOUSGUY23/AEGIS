        function createSamplePdf() {
            const canvas = document.getElementById('pdfCanvas');
            const ctx = canvas.getContext('2d');
            canvas.width = 620;
            canvas.height = 840;

            ctx.fillStyle = '#080e1e';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = '#00f0ff';
            ctx.font = 'bold 20px Orbitron';
            ctx.fillText("AEGIS ACADEMIC EXAMINATION PAPER", 40, 50);

            ctx.strokeStyle = '#1e293b';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(40, 70);
            ctx.lineTo(580, 70);
            ctx.stroke();

            ctx.fillStyle = '#94a3b8';
            ctx.font = '13px JetBrains Mono';
            ctx.fillText("Course: Quantum Physics & Computer Vision Systems", 40, 100);
            ctx.fillText("Time Allowed: Configured Duration | Total Marks: 100", 40, 120);

            let y = 170;
            const textLines = [
                { type: 'header', text: "SECTION A: QUANTUM MECHANICS [40 Marks]" },
                { type: 'body', text: "Q1. Derive Schrödinger's time-dependent wave equation for a particle" },
                { type: 'body', text: "    in three-dimensional space." },
                { type: 'body', text: "" },
                { type: 'body', text: "Q2. Explain Heisenberg's Uncertainty Principle and demonstrate how it prevents" },
                { type: 'body', text: "    an electron from collapsing into the atomic nucleus." },
                { type: 'body', text: "" },
                { type: 'header', text: "SECTION B: COMPUTER VISION & SECURITY PROTOCOLS [60 Marks]" },
                { type: 'body', text: "Q3. Formulate skin-tone luminance matrix algorithms for frame presence check." },
                { type: 'body', text: "" },
                { type: 'body', text: "Q4. Detail how event-driven browser focus locks prevent unauthorized task switching." }
            ];

            textLines.forEach(item => {
                if (item.type === 'header') {
                    ctx.fillStyle = '#38bdf8';
                    ctx.font = 'bold 15px Orbitron';
                    y += 10;
                } else {
                    ctx.fillStyle = '#cbd5e1';
                    ctx.font = '13px JetBrains Mono';
                }
                ctx.fillText(item.text, 40, y);
                y += 24;
            });

            document.getElementById('pdfLoadingSpinner').classList.add('hidden');
            state.pdfTotalPages = 1;
            document.getElementById('pdfTotalPages').innerText = '1';
        }

        async function loadPdfDocument(data) {
            document.getElementById('pdfLoadingSpinner').classList.remove('hidden');
            try {
                state.pdfDoc = await pdfjsLib.getDocument({ data: data }).promise;
                state.pdfTotalPages = state.pdfDoc.numPages;
                document.getElementById('pdfTotalPages').innerText = state.pdfTotalPages;
                renderPdfPage(1);
            } catch (err) {
                createSamplePdf();
            }
        }

        async function renderPdfPage(num) {
            if (!state.pdfDoc) return;
            state.pdfCurrentPage = num;
            document.getElementById('pdfCurrentPage').innerText = num;
            
            const page = await state.pdfDoc.getPage(num);
            const viewport = page.getViewport({ scale: state.pdfScale });
            const canvas = document.getElementById('pdfCanvas');
            const ctx = canvas.getContext('2d');

            canvas.height = viewport.height;
            canvas.width = viewport.width;

            await page.render({ canvasContext: ctx, viewport: viewport }).promise;
            document.getElementById('pdfLoadingSpinner').classList.add('hidden');
        }

        document.getElementById('pdfPrevPage').addEventListener('click', () => {
            if (state.pdfCurrentPage > 1) renderPdfPage(state.pdfCurrentPage - 1);
        });
        document.getElementById('pdfNextPage').addEventListener('click', () => {
            if (state.pdfCurrentPage < state.pdfTotalPages) renderPdfPage(state.pdfCurrentPage + 1);
        });
        document.getElementById('pdfZoomIn').addEventListener('click', () => {
            state.pdfScale += 0.2;
            document.getElementById('zoomLevelText').innerText = Math.round(state.pdfScale * 100) + '%';
            if (state.pdfDoc) renderPdfPage(state.pdfCurrentPage);
        });
        document.getElementById('pdfZoomOut').addEventListener('click', () => {
            if (state.pdfScale > 0.6) {
                state.pdfScale -= 0.2;
                document.getElementById('zoomLevelText').innerText = Math.round(state.pdfScale * 100) + '%';
                if (state.pdfDoc) renderPdfPage(state.pdfCurrentPage);
            }
        });

        /* ==========================================================================
           5. WEBCAM & HARDWARE COMPUTER VISION ENGINE
           ========================================================================== */
        const previewWebcam = document.getElementById('previewWebcam');
        const examWebcam = document.getElementById('examWebcam');
        const camPlaceholder = document.getElementById('camPlaceholder');
        const startCamCheckBtn = document.getElementById('startCamCheckBtn');
        const camStatusBadge = document.getElementById('camStatusBadge');

        startCamCheckBtn.addEventListener('click', async () => {
            synth.init();
            synth.playClick();
            await initWebcam();
        });

        async function initWebcam() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { width: { ideal: 640 }, height: { ideal: 480 }, frameRate: { ideal: 30 } },
                    audio: false
                });
                state.webcamStream = stream;
                previewWebcam.srcObject = stream;
                examWebcam.srcObject = stream;

                camPlaceholder.classList.add('hidden');
                camStatusBadge.innerText = 'ONLINE';
                camStatusBadge.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-cyber-green/20 text-cyber-green border border-cyber-green/40';

                logSecurityEvent("Webcam stream connected to AEGIS Vision Engine.");
                updateStartButtonState();
            } catch (err) {
                alert("Camera access denied or unavailable. Please connect a webcam.");
            }
        }

        /* HARDWARE VISION ANALYZER (Skin-Tone Presence & Lens Covered Brightness Check) */
        function analyzeFrameWithCV(video) {
            const tempCanvas = document.createElement('canvas');
            const w = 160;
            const h = 120;
            tempCanvas.width = w;
            tempCanvas.height = h;
            const ctx = tempCanvas.getContext('2d');
            ctx.drawImage(video, 0, 0, w, h);

            const imgData = ctx.getImageData(0, 0, w, h);
            const data = imgData.data;

            let totalBrightness = 0;
            let skinPixelCount = 0;

            for (let i = 0; i < data.length; i += 4) {
                const r = data[i];
                const g = data[i+1];
                const b = data[i+2];

                // Brightness
                const brightness = (r + g + b) / 3;
                totalBrightness += brightness;

                // Human Skin Color Heuristic (RGB space)
                if (r > 60 && g > 35 && b > 20 && (r - g) > 12 && r > g && r > b) {
                    skinPixelCount++;
                }
            }

            const totalPixels = w * h;
            const avgBrightness = totalBrightness / totalPixels;
            const skinRatio = skinPixelCount / totalPixels;

            const personVisible = skinRatio > 0.012; // Skin presence threshold
            const lensCovered = avgBrightness < 10; // Dark frame / covered lens threshold

            return {
                avgBrightness: Math.round(avgBrightness),
                personVisible,
                lensCovered,
                skinPercent: Math.round(skinRatio * 100)
            };
        }

        function drawBoundingBoxes(canvas, cvAnalysis) {
            const ctx = canvas.getContext('2d');
            canvas.width = examWebcam.clientWidth || 320;
            canvas.height = examWebcam.clientHeight || 240;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            ctx.strokeStyle = cvAnalysis.personVisible ? '#10b981' : '#ef4444';
            ctx.lineWidth = 2;
            ctx.strokeRect(10, 10, canvas.width - 20, canvas.height - 20);

            ctx.font = 'bold 10px JetBrains Mono';
            ctx.fillStyle = cvAnalysis.personVisible ? '#10b981' : '#ef4444';
            ctx.fillText(`STATUS: ${cvAnalysis.personVisible ? 'USER PRESENT' : 'NO USER'} | LUM: ${cvAnalysis.avgBrightness}`, 15, 25);
        }

        /* Real-Time Detection Loop */
        function runObjectDetectionLoop() {
            if (state.stage !== 'EXAM' || !examWebcam.srcObject) return;

            const now = performance.now();
            const delta = now - state.lastFrameTime;
            state.fps = Math.round(1000 / delta);
            state.lastFrameTime = now;
            document.getElementById('fpsCounter').innerText = `${state.fps} FPS`;

            const cvAnalysis = analyzeFrameWithCV(examWebcam);

            // 1. CAMERA COVERED DETECTION
            const luminanceMetric = document.getElementById('luminanceMetric');
            if (cvAnalysis.lensCovered) {
                state.consecutiveDarkFrames++;
                luminanceMetric.innerText = 'DARK / COVERED!';
                luminanceMetric.className = 'text-red-500 font-bold animate-pulse';

                if (state.consecutiveDarkFrames > 12) { // ~1.2s covered
                    triggerDisqualification("Camera Lens Covered or Feed Obstructed (Camera Lens Lock Breach)");
                    return;
                }
            } else {
                state.consecutiveDarkFrames = 0;
                luminanceMetric.innerText = 'CLEAR';
                luminanceMetric.className = 'text-cyber-green font-bold';
            }

            // 2. USER ABSENCE DETECTION (> 2 SECONDS TRIGGER)
            const presenceMetric = document.getElementById('presenceMetric');
            if (!cvAnalysis.personVisible) {
                state.consecutiveAbsenceFrames++;
                presenceMetric.innerText = `ABSENT (${(state.consecutiveAbsenceFrames * 0.1).toFixed(1)}s)`;
                presenceMetric.className = 'text-red-500 font-bold animate-pulse';

                if (state.consecutiveAbsenceFrames >= 20) { // 20 frames @ 10fps = > 2.0 seconds
                    triggerDisqualification("User Absent From Camera View (> 2.0s Absence Lock Breach)");
                    return;
                }
            } else {
                state.consecutiveAbsenceFrames = 0;
                presenceMetric.innerText = 'VERIFIED';
                presenceMetric.className = 'text-cyber-green font-bold';
            }

            const canvas = document.getElementById('examBoundingCanvas');
            drawBoundingBoxes(canvas, cvAnalysis);

            if (state.stage === 'EXAM') {
                state.detectionLoopId = requestAnimationFrame(runObjectDetectionLoop);
            }
        }

        /* ==========================================================================
           6. SECURITY ENFORCEMENT ENGINE
           ========================================================================== */
        function triggerDisqualification(reason) {
            if (state.stage === 'DISQUALIFIED' || state.stage === 'SUBMITTED') return;

            state.stage = 'DISQUALIFIED';
            clearInterval(state.timerInterval);
            if (state.detectionLoopId) cancelAnimationFrame(state.detectionLoopId);

            synth.playAlarm();

            document.getElementById('violationReasonText').innerText = reason;
            document.getElementById('violationTimestamp').innerText = new Date().toUTCString();
            document.getElementById('violationRefCode').innerText = '#AEGIS-BREACH-' + Math.floor(1000 + Math.random() * 9000);

            examStage.classList.add('hidden');
            setupStage.classList.add('hidden');
            disqualifiedStage.classList.remove('hidden');

            logSecurityEvent(`CRITICAL BREACH: ${reason}`, 'danger');
        }

        function logSecurityEvent(msg, type = 'info') {
            const consoleBox = document.getElementById('securityLogConsole');
            if (!consoleBox) return;
            const entry = document.createElement('div');
            const timeStr = new Date().toTimeString().split(' ')[0];

            if (type === 'danger') {
                entry.className = 'text-red-400 font-bold';
            } else if (type === 'warning') {
                entry.className = 'text-cyber-amber';
            } else {
                entry.className = 'text-cyber-cyan';
            }

            entry.innerText = `[${timeStr}] ${msg}`;
            consoleBox.appendChild(entry);
            consoleBox.scrollTop = consoleBox.scrollHeight;
        }

        // Fullscreen Exit Enforcement
        document.addEventListener('fullscreenchange', () => {
            if (state.stage === 'EXAM' && !document.fullscreenElement) {
                triggerDisqualification("Exited Fullscreen Mode (Screen/Tab Lock Breach)");
            }
        });

        // Tab Switch / Page Visibility Enforcement
        document.addEventListener('visibilitychange', () => {
            if (state.stage === 'EXAM' && document.hidden) {
                triggerDisqualification("Tab / Screen Switch Detected (Screen/Tab Lock Breach)");
            }
        });

        // Window Blur Enforcement
        window.addEventListener('blur', () => {
            if (state.stage === 'EXAM') {
                triggerDisqualification("Window Lost Focus / External App Opened");
            }
        });

        // Block Right-Click Context Menu & Developer Shortcuts
        document.addEventListener('contextmenu', (e) => {
            if (state.stage === 'EXAM') {
                e.preventDefault();
                logSecurityEvent("Blocked right-click context menu.", 'warning');
                synth.playAlarm();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (state.stage === 'EXAM') {
                if (
                    e.key === 'F12' || 
                    (e.ctrlKey && (e.key === 'c' || e.key === 'v' || e.key === 'u' || e.key === 'a' || e.key === 'p')) ||
                    e.key === 'PrintScreen'
                ) {
                    e.preventDefault();
                    logSecurityEvent(`Blocked restricted key shortcut: [${e.key.toUpperCase()}]`, 'warning');
                    synth.playAlarm();
                }
            }
        });

        /* ==========================================================================
           7. EXAM START, TIMER & SUBMISSION
           ========================================================================== */
        startTestBtn.addEventListener('click', async () => {
            synth.init();
            synth.playLockdownChime();

            try {
                if (document.documentElement.requestFullscreen) {
                    await document.documentElement.requestFullscreen();
                }
            } catch (err) {
                console.warn("Fullscreen error:", err);
            }

            state.stage = 'EXAM';
            setupStage.classList.add('hidden');
            examStage.classList.remove('hidden');
            hudHeaderMetrics.classList.remove('hidden');

            if (!state.pdfDoc) {
                createSamplePdf();
            } else {
                renderPdfPage(1);
            }

            state.totalExamSeconds = state.selectedDurationMinutes * 60;
            state.timeRemainingSeconds = state.totalExamSeconds;
            updateTimerDisplay();

            state.timerInterval = setInterval(() => {
                state.timeRemainingSeconds--;
                updateTimerDisplay();

                if (state.timeRemainingSeconds <= 0) {
                    clearInterval(state.timerInterval);
                    finalizeSubmission();
                }
            }, 1000);

            runObjectDetectionLoop();
            logSecurityEvent("Lockdown session active. All proctoring engines online.");
        });

        function updateTimerDisplay() {
            const hrs = Math.floor(state.timeRemainingSeconds / 3600);
            const mins = Math.floor((state.timeRemainingSeconds % 3600) / 60);
            const secs = state.timeRemainingSeconds % 60;

            const pad = (num) => String(num).padStart(2, '0');
            examTimer.innerText = `${pad(hrs)}:${pad(mins)}:${pad(secs)}`;

            // SVG Circular Progress Ring Update
            const circumference = 75.39; // 2 * pi * r (12)
            const progressRatio = state.timeRemainingSeconds / state.totalExamSeconds;
            const strokeDashoffset = circumference - (progressRatio * circumference);
            timerProgressRing.style.strokeDashoffset = strokeDashoffset;

            if (state.timeRemainingSeconds < 60) {
                examTimer.classList.remove('text-cyber-cyan');
                examTimer.classList.add('text-red-500', 'animate-pulse');
                timerProgressRing.classList.remove('text-cyber-cyan');
                timerProgressRing.classList.add('text-red-500');
            }
        }

        // Student Answer Text Counter & Draft Saver
        const studentAnswerText = document.getElementById('studentAnswerText');
        const charCount = document.getElementById('charCount');
        const wordCount = document.getElementById('wordCount');

        studentAnswerText.addEventListener('input', () => {
            const text = studentAnswerText.value;
            charCount.innerText = text.length;
            const words = text.trim() ? text.trim().split(/\s+/).length : 0;
            wordCount.innerText = words;
        });

        document.getElementById('submitExamBtn').addEventListener('click', () => {
            synth.init();
            synth.playClick();
            finalizeSubmission();
        });

        function finalizeSubmission() {
            state.stage = 'SUBMITTED';
            clearInterval(state.timerInterval);
            if (state.detectionLoopId) cancelAnimationFrame(state.detectionLoopId);

            synth.playSuccess();

            if (document.fullscreenElement) {
                document.exitFullscreen().catch(() => {});
            }

            const spentSecs = state.totalExamSeconds - state.timeRemainingSeconds;
            const mins = Math.floor(spentSecs / 60);
            const secs = spentSecs % 60;
            document.getElementById('subTimeSpent').innerText = `${mins}m ${secs}s`;
            document.getElementById('subHash').innerText = '#AEGIS-' + Math.floor(100000 + Math.random() * 900000);

            submissionModal.classList.remove('hidden');
        }

        /* ==========================================================================
           8. DIAGNOSTICS & BREACH SIMULATOR UTILITIES
           ========================================================================== */
        const debugChevron = document.getElementById('debugChevron');
        const debugContent = document.getElementById('debugContent');
        let debugOpen = true;

        document.getElementById('toggleDebugBtn').addEventListener('click', () => {
            debugOpen = !debugOpen;
            if (debugOpen) {
                debugContent.classList.remove('hidden');
                debugChevron.style.transform = 'rotate(0deg)';
            } else {
                debugContent.classList.add('hidden');
                debugChevron.style.transform = 'rotate(180deg)';
            }
        });

        document.getElementById('simTabSwitchBtn').addEventListener('click', () => {
            triggerDisqualification("Tab / Screen Switch Detected (Simulated Trigger)");
        });

        document.getElementById('simAbsenceBtn').addEventListener('click', () => {
            triggerDisqualification("User Absent From Camera View (> 2.0s Simulated)");
        });

        document.getElementById('simDarkBtn').addEventListener('click', () => {
            triggerDisqualification("Camera Lens Covered or Obstructed (Simulated)");
        });

        document.getElementById('simPhoneBtn').addEventListener('click', () => {
            triggerDisqualification("External Device / Cell Phone Detected (Simulated)");
        });

        document.getElementById('finishModalBtn').addEventListener('click', () => location.reload());
        document.getElementById('resetAppBtn').addEventListener('click', () => location.reload());

        lucide.createIcons();
    </script>
</body>
</html>
