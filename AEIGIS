            } else {
                startTestBtn.disabled = true;
                startTestBtn.classList.add('bg-slate-800', 'border-slate-700', 'text-slate-500', 'cursor-not-allowed');
                startTestBtn.classList.remove('bg-cyber-cyan/20', 'border-cyber-cyan', 'text-cyber-cyan', 'hover:bg-cyber-cyan/30', 'shadow-[0_0_20px_rgba(0,240,255,0.3)]');
                startTestBtn.innerHTML = `<i data-lucide="shield-alert" class="w-5 h-5"></i><span>START EXAM (AWAITING CHECKLIST)</span>`;
            }
            lucide.createIcons();
        }

        chkRules.addEventListener('change', updateStartButtonState);
        chkDevices.addEventListener('change', updateStartButtonState);

        const pdfFileInput = document.getElementById('pdfFileInput');
        const pdfDropZone = document.getElementById('pdfDropZone');
        const pdfFileName = document.getElementById('pdfFileName');

        pdfDropZone.addEventListener('click', (e) => {
            if (e.target.id !== 'loadSamplePdfBtn' && !e.target.closest('#loadSamplePdfBtn')) {
                pdfFileInput.click();
            }
        });

        pdfFileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file && file.type === 'application/pdf') {
                pdfFileName.innerText = file.name;
                document.getElementById('pdfTitleDisplay').innerText = file.name;
                const fileReader = new FileReader();
                fileReader.onload = function() {
                    const typedarray = new Uint8Array(this.result);
                    loadPdfDocument(typedarray);
                };
                fileReader.readAsArrayBuffer(file);
            }
        });

        document.getElementById('loadSamplePdfBtn').addEventListener('click', (e) => {
            e.stopPropagation();
            synth.init();
            synth.playClick();
            pdfFileName.innerText = 'Quantum_Physics_Final_Exam.pdf';
            document.getElementById('pdfTitleDisplay').innerText = 'Quantum_Physics_Final_Exam.pdf';
            createSamplePdf();
