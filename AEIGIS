        /* ==========================================================================
           4. PRE-EXAM SETUP & PDF READER LOGIC
           ========================================================================== */
        const durationBtns = document.querySelectorAll('.duration-btn');
        const customDurationInputBox = document.getElementById('customDurationInputBox');
        const customDurationMinutes = document.getElementById('customDurationMinutes');

        durationBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                synth.init();
                synth.playClick();
                durationBtns.forEach(b => {
                    b.classList.remove('active', 'bg-cyber-cyan/20', 'border-cyber-cyan', 'text-white');
